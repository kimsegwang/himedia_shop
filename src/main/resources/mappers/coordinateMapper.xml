<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tobi.himedia_shop.mapper.CoordinateMapper">
    <resultMap id="Coordinate" type="com.example.tobi.himedia_shop.model.Coordinate">
        <result property="id" column="id" />
        <result property="nx"   column="nx" />
        <result property="ny"   column="ny" />
    </resultMap>

    <select id="findCoordinate" parameterType="int">
        SELECT
            nx,ny
        FROM coordinate
        where
            id = #{id}
    </select>









</mapper>