<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.tobi.himedia_shop.mapper.SearchProductMapper">
    <resultMap id="productSearchResultMap" type="com.example.tobi.himedia_shop.model.Products">
        <result property="id" column="id" />
        <result property="category" column="category" />
        <result property="subCategory" column="sub_category" />
        <result property="sellerId" column="seller_id" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="contentImg" column="content_img" />
        <result property="created" column="created" />
        <result property="updated" column="updated" />
        <result property="stock" column="stock" />
        <result property="price" column="price" />
        <result property="temperature" column="temperature" />
        <result property="precipitation" column="precipitation" />
    </resultMap>
    <select id="searchProducts" parameterType="String" resultMap="productSearchResultMap">
        SELECT id,category,sub_category,seller_id,title,content,content_img,created,updated,stock,price,temperature,precipitation FROM products
        WHERE (title LIKE CONCAT('%', #{keyword}, '%')
            OR content LIKE CONCAT('%', #{keyword}, '%'))
    </select>
    <select id="categoryProduct" parameterType="map" resultMap="productSearchResultMap">
        SELECT * FROM products
        WHERE category = #{category} AND sub_category = #{subCategory}
    </select>
</mapper>